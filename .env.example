# Local sample demo needs no variables. Real recognition needs the server-only
# settings below in the EXISTING Vercel project (Production and/or Preview).
# Never prefix credentials with NEXT_PUBLIC_ or commit real secret values.

# Existing private access. Keep the owner's current value unchanged.
# STUDIO_ACCESS_PASSWORD=

# Task 02A: server-side Deepgram and existing private R2 storage.
# DEEPGRAM_API_KEY=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# Keep false until explicit approval of the first paid pilot.
# DEEPGRAM_PILOT_ENABLED=false

# Future integrations: not read or called in Task 02A.
# OPENAI_API_KEY=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=
# WORKER_BASE_URL=
# WORKER_AUTH_TOKEN=
